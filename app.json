{
  "expo": {
    "name": "Scoreboards",
    "slug": "scoreboards",
    "version": "2.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "backgroundColor": "#123b2f",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liperasz.scoreboards",
      "infoPlist": {
        "LSApplicationCategoryType": "public.app-category.board-games"
      }
    },
    "android": {
      "package": "com.liperasz.scoreboards",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-mono.png",
        "backgroundColor": "#123b2f"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#123b2f"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withGameCategory"
    ]
  }
}
